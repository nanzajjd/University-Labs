<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ComplexSolver.ViewModels"
    x:Class="ComplexSolver.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Width="1000"
    Height="650"
    Title="Complex Solver">

    <Window.Styles>

        <Style Selector="Button">
            <Setter Property="Width" Value="170" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="12" />

            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background"
                        Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1D4ED8" />
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Thumb">
            <Setter Property="Background" Value="#CBD5E1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Thumb:pointerover">
            <Setter Property="Background" Value="#94A3B8" />
        </Style>

    </Window.Styles>

    <Grid ColumnDefinitions="300,*"
        Margin="10">

        <ScrollViewer Grid.Column="0"
            VerticalScrollBarVisibility="Auto"
            Padding="0,0,22,0">

            <StackPanel Spacing="10">

                <Border BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Background="#F8FAFC">

                    <StackPanel Spacing="8">

                        <TextBlock Text="Parameters"
                            FontSize="18"
                            FontWeight="Bold" />

                        <TextBlock Text="{Binding FunctionLabel}"
                            FontSize="16" />

                        <TextBox Text="{Binding FunctionInput}"
                            PlaceholderText="Enter function..." />

                        <TextBlock Text="Epsilon"
                            FontSize="16" />

                        <TextBox Text="{Binding Epsilon}"
                            PlaceholderText="Enter epsilon..." />

                        <StackPanel IsVisible="{Binding ShowBorders}"
                            Spacing="8">

                            <TextBlock Text="Left border"
                                FontSize="16" />

                            <TextBox Text="{Binding LeftBorder}"
                                PlaceholderText="Enter left border..." />

                            <TextBlock Text="Right border"
                                FontSize="16" />

                            <TextBox Text="{Binding RightBorder}"
                                PlaceholderText="Enter right border..." />

                        </StackPanel>

                        <TextBlock Text="Method:"
                            FontSize="16" />

                        <ComboBox ItemsSource="{Binding Methods}"
                            SelectedItem="{Binding SelectedMethod}" />

                    </StackPanel>

                </Border>

                <Border BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Background="#F8FAFC">

                    <StackPanel Spacing="8">

                        <TextBlock Text="Controls"
                            FontSize="18"
                            FontWeight="Bold" />

                        <Button Content="Solve"
                            Height="45"
                            Command="{Binding SolveCommand}" />

                        <Button Content="Draw Graphic"
                            Height="45"
                            Command="{Binding GraphCommand}" />

                        <Button Content="Show Complexity"
                            Height="45"
                            Command="{Binding ComplexityCommand}" />

                        <Button Content="Draw Fractal"
                            Height="45"
                            Command="{Binding FractalCommand}"
                            IsVisible="{Binding ShowFractalButton}" />

                        <Button Content="Save To File"
                            Height="45"
                            Command="{Binding SaveCommand}" />

                        <Button Content="Clear"
                            Height="45"
                            Command="{Binding ClearCommand}" />


                    </StackPanel>

                </Border>

                <TextBlock Text="Result:"
                    Margin="0,10,0,0"
                    FontSize="18"
                    FontWeight="Bold" />

                <Border BorderBrush="Black"
                    BorderThickness="2"
                    Padding="12"
                    CornerRadius="10"
                    MinHeight="120">

                    <TextBlock Text="{Binding ResultText}"
                        TextWrapping="Wrap"
                        Foreground="Black"
                        FontSize="16" />

                </Border>

            </StackPanel>

        </ScrollViewer>

        <Border Grid.Column="1"
            Margin="10"
            Background="#F8FAFC"
            BorderBrush="#CBD5E1"
            BorderThickness="2"
            CornerRadius="14"
            Padding="10">

            <Grid RowDefinitions="70,*">

                <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">

                    <TextBlock Text="{Binding GraphTitle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#475569" />

                </Border>

                <Grid Grid.Row="1">

                    <Canvas x:Name="GraphCanvas"
                        Background="Transparent"
                        IsVisible="False" />

                    <Image x:Name="FractalImage"
                        Source="{Binding FractalBitmap}"
                        Stretch="Uniform" />

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>